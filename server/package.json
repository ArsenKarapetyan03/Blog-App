{
  "name": "server",
  "version": "1.0.0",
  "description": "Blog App",
  "license": "ISC",
  "author": "",
  "type": "module",
  "imports": {
    "#models/*": "./models/*",
    "#config/*": "./config/*"
  },
  "main": "server.ts",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "model:generate": "npx sequelize-cli model:generate --name User --attributes name:string,email:string,password:string",
    "db:migrate": "npx sequelize-cli db:migrate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
